{
  "name": "smart-campus-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "emulators": "firebase emulators:start --only auth,firestore",
    "seed": "NEXT_PUBLIC_FIREBASE_EMULATORS=1 node scripts/seed-users.mjs",
    "bootstrap": "node scripts/bootstrap-live.mjs",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:data": "npx vite-node --config vitest.config.mts scripts/seed-firestore.ts",
    "init:project": "npx vite-node --config vitest.config.mts scripts/init-project.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "firebase": "^12.19.0",
    "lucide-react": "^1.43.0",
    "motion": "^13.4.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "firebase-admin": "^14.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
