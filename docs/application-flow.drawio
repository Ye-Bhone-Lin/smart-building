        <mxCell id="fc_nSix" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" value="&lt;b&gt;Six actions demand a reason&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;declining a request · deleting a building · decommissioning a unit · deleting a unit · resetting a fire alarm · removing a sensor.&lt;br&gt;Each stores it on the log entry as &lt;i&gt;reason&lt;/i&gt;, and Historical Records shows it under the row. Never collect one and drop it." vertex="1">
          <mxGeometry height="170" width="300" x="2210" y="350" as="geometry" />
        </mxCell>
        <mxCell id="fc_nTwo" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" value="The two gates say the same thing on purpose. permissions.ts decides what to draw; firestore.rules decides what is allowed. When a can* predicate changes, the matching rule belongs in the same commit." vertex="1">
