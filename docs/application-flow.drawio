          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="layers_e4" value="gates the UI" style="endArrow=open;dashed=1;html=1;strokeColor=#6b7280;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="layers_lPerm" target="layers_lPages">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="layers_e5" value="gates the data" style="endArrow=open;dashed=1;html=1;strokeColor=#6b7280;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="layers_lRules" target="layers_lDb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="layers_e6" value="must say the same thing" style="endArrow=block;startArrow=block;endFill=1;startFill=1;dashed=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="layers_lPerm" target="layers_lRules">
          <mxGeometry relative="1" as="geometry" />
