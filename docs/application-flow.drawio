  <diagram id="er" name="6 · Entity relationships">
    <mxGraphModel dx="5295" dy="3338" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0" />
