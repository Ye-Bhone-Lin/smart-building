        <mxCell id="er_21" edge="1" parent="1" source="er_room" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#6b7280;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=8" target="er_meas" value="room.type picks the band set">
          <mxGeometry relative="1" as="geometry">
