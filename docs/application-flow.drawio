        <mxCell id="uc_uLog" value="Write a Log Book entry" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2fd;strokeColor=#4169e1;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="495" y="1075" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="uc_nInc" value="&lt;b&gt;«include» applies to every use case that writes.&lt;/b&gt;&lt;br&gt;Four are drawn to keep the diagram readable. app-state.tsx logs what it owns; a screen holding its own state calls log() itself. A &lt;i&gt;refused&lt;/i&gt; change writes nothing." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="990" y="1060" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="uc_nEdit" value="&lt;b&gt;Generalisation cannot express this.&lt;/b&gt;&lt;br&gt;canEditUser: an Admin Manager may edit &lt;b&gt;Office Staff rows only&lt;/b&gt; — not another Admin Manager, not the CEO. And &lt;b&gt;nobody may edit their own row&lt;/b&gt;, the CEO included. Changing your own name and phone is Settings, not Administration." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fdeeee;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="990" y="640" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="uc_nSensor" value="Sensors are read-only for Office Staff: they see every state, and every action carries a padlock with SENSOR_LOCK_REASON in its tooltip. Equipment is the one place staff act on assets — only decommission and delete are closed to them." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="990" y="200" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="uc_nScope" value="Office Staff are building-locked everywhere (isBuildingLocked), so &amp;quot;view&amp;quot; and &amp;quot;search&amp;quot; mean &lt;i&gt;their&lt;/i&gt; building. Admin Manager and CEO see the whole estate." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="990" y="340" width="380" height="90" as="geometry" />
        </mxCell>
