  <diagram id="layers" name="4 · Affordance vs enforcement">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="layers_t4" value="Where a rule is decided, and where it is enforced" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontStyle=1;fontColor=#1f2430" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="layers_t4s" value="The two are different layers and they have to agree. When a can* predicate changes, the matching rule belongs in the same commit." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#6b7280" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="760" height="32" as="geometry" />
        </mxCell>
        <mxCell id="layers_lPages" value="&lt;b&gt;Pages&lt;/b&gt;  &lt;i&gt;src/app/(app)/*&lt;/i&gt;&lt;hr size=&#39;1&#39;&gt;9 routes. Read through useAppState(), never from a store hook directly and never from the seed arrays. A control a role may not use stays on screen under a padlock." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#4169e1;fontSize=12;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="layers_lState" value="&lt;b&gt;useAppState()&lt;/b&gt;  &lt;i&gt;src/lib/app-state.tsx&lt;/i&gt;&lt;hr size=&#39;1&#39;&gt;Resolves every subscription into one list per domain, so the sidebar badge, the toolbar chips and the dashboard tiles cannot disagree. Holds the mutators." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#4169e1;fontSize=12;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="layers_lStores" value="&lt;b&gt;Store modules&lt;/b&gt;  &lt;i&gt;src/lib/*-store.ts&lt;/i&gt;&lt;hr size=&#39;1&#39;&gt;users · logBook · estate · sensor-types · sensors · equipment · equipment-types · requests · reports · media&lt;br&gt;useLiveCollection + writes returning WriteResult. Timestamps become ISO strings in store-mappers.ts and nowhere else." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#4169e1;fontSize=12;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1">
          <mxGeometry x="340" y="410" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="layers_lDb" value="&lt;b&gt;Firestore&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;11 collections, live onSnapshot. Human ids are document ids. Every query is single-collection and single-field-ordered, so firestore.indexes.json stays empty." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#eef2fd;strokeColor=#2f4fb8;fontSize=12;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1">
          <mxGeometry x="340" y="570" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="layers_lPure" value="&lt;b&gt;Pure rules&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;derive.ts — escalation, due-service, offline, statusTone, counts, KPI&lt;br&gt;format.ts · estate-rules.ts · photo.ts&lt;hr size=&#39;1&#39;&gt;&lt;i&gt;Import no data. Change a threshold here, not in a migration.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#eefaf1;strokeColor=#2e7d4f;fontSize=12;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="layers_lPerm" value="&lt;b&gt;Affordance layer&lt;/b&gt;&lt;br&gt;&lt;i&gt;src/lib/permissions.ts&lt;/i&gt;&lt;hr size=&#39;1&#39;&gt;Decides what a padlock looks like and which nav items render. Gates on &lt;b&gt;rank&lt;/b&gt;, never on role equality.&lt;hr size=&#39;1&#39;&gt;&lt;i&gt;Runs in the browser. Stops nothing.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#4169e1;fontSize=12;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1">
          <mxGeometry x="780" y="250" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="layers_lRules" value="&lt;b&gt;Enforcement layer&lt;/b&gt;&lt;br&gt;&lt;i&gt;firestore.rules&lt;/i&gt;&lt;hr size=&#39;1&#39;&gt;The only thing that can actually refuse a write, because it runs on Google&#39;s servers.&lt;hr size=&#39;1&#39;&gt;&lt;b&gt;Deployed, covering all 11 collections.&lt;/b&gt; The matrix is verified against the emulator rather than asserted." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fdeeee;strokeColor=#c0392b;fontSize=12;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1">
          <mxGeometry x="780" y="500" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="layers_nGate" value="The route guard in shell/auth-gate.tsx is &lt;b&gt;UX, not security&lt;/b&gt;. A client-only SDK has no server-side gate; it exists so nobody lands on a chrome-full dashboard while signed out." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="780" y="90" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="layers_nRules" value="&lt;b&gt;What this means for the report.&lt;/b&gt;&lt;br&gt;Every constraint on pages 1–3 is drawn by the browser &lt;i&gt;and&lt;/i&gt; enforced on the server. The API key is public and sits in the bundle; it is not the authorisation layer and never was — firestore.rules is. Where the two disagree the SDK throws permission-denied, and (app)/error.tsx gives that a 403 with no retry rather than a crash." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fdeeee;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="layers_e0" value="reads / calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="layers_lPages" target="layers_lState">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="layers_e1" value="useX() + writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="layers_lState" target="layers_lStores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="layers_e2" value="onSnapshot · setDoc · writeBatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1" source="layers_lStores" target="layers_lDb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
