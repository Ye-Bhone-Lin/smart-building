        <mxCell id="sess_noteSusp" value="Suspension works &lt;i&gt;through the rules&lt;/i&gt;: a suspended account&#39;s own profile read is refused, and auth.tsx turns that permission-denied into a sign-out. It looks like a bug if you do not know that." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=top;spacing=8;fontSize=11" vertex="1" parent="1">
