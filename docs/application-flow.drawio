        <mxCell id="fc_c10" edge="1" parent="1" source="fc_live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4169e1;fontSize=10;labelBackgroundColor=#ffffff" target="fc_toast" value="">
